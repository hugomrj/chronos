# ---------------------------------------------------------------------
# Instancia: cada proceso/servidor sirve UN colegio.
# El ID se define al crear la instancia (ver scripts/nuevo_colegio.py).
# ---------------------------------------------------------------------
# Modo panel (administra colegios): dejar vacío o 0.
# Instancia de colegio: id del colegio en la tabla colegio.
COLEGIO_ID=1

FLASK_APP=run.py
FLASK_CONFIG=production
SECRET_KEY=cambia-esta-clave-por-una-de-64-caracteres-hex
DEBUG=False
HOST=127.0.0.1
PORT=8000

# ---------------------------------------------------------------------
# Base de datos (compartida entre instancias)
# ---------------------------------------------------------------------
DB_USER=chronos_user
DB_PASS=cambia-esta-password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chronos_db

# ---------------------------------------------------------------------
# Seguridad
# ---------------------------------------------------------------------
# CSRF en todos los formularios POST.
CSRF_ENABLED=True
# True si el sitio va por HTTPS (recomendado en producción).
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE=Lax
# Duración de la sesión en segundos (8 h por defecto).
SESSION_LIFETIME=28800
# True si hay nginx/apache delante (necesario para detectar HTTPS).
USE_PROXY_FIX=True

# ---------------------------------------------------------------------
# Portal maestro: solo la instancia que administra colegios.
# ---------------------------------------------------------------------
SUPERADMIN=False
